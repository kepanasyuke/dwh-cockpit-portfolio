{
  "$source": "https://ostrovok.ru — снято с инлайн-CSS бренда (palette/t-radius/t-spacing) и mpf.fastrovok.net CSS (font-family: Spoof)",
  "brand": {
    "font": "Spoof",
    "fontFallback": "Spoof, system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
  },
  "color": {
    "primary": "#0E41D2",
    "primaryHover": "#0636C8",
    "primaryActive": "#0017B0",
    "secondary": "#E3EBFD",
    "secondaryHover": "#E0E8FA",
    "text": "#2D3137",
    "textSecondary": "#868686",
    "textPlaceholder": "#AFAFAF",
    "neutral20": "#C8C8C8",
    "neutral10": "#E5E5E5",
    "neutral05": "#F4F4F4",
    "neutral03": "#F8F8F8",
    "white": "#FFFFFF",
    "success": "#53AF24",
    "successBg": "#DDEFD3",
    "warning": "#E77D00",
    "warningBg": "#FAE5CC",
    "alert": "#CE2121",
    "alertBg": "#FAE9E9",
    "highlight": "#FFF8E6"
  },
  "radius": { "2xs": "4px", "xs": "6px", "sm": "8px", "md": "12px", "lg": "20px" },
  "spacing": { "2xs": "2px", "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "20px", "2xl": "24px" },
  "fontSize": { "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px" },
  "shadow": { "card": "0 1px 2px rgba(45,49,55,0.08), 0 8px 24px rgba(45,49,55,0.06)" }
}
